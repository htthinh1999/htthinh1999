{
  "name": "htthinh1999-profile",
  "version": "2.0.0",
  "private": true,
  "description": "GitHub profile README with self-hosted, WakaTime-free metric cards",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "metrics": "node scripts/profile-metrics/cli.mjs",
